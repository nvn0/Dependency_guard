#include <tunables/global>

profile nodejs-dev flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>
  #include <abstractions/ssl_certs>

  # ── Capabilities ──────────────────────────────────────────────
  capability dac_override,
  capability dac_read_search,
  capability setgid,
  capability setuid,
  capability setfcap,
  capability net_bind_service,
  capability chown,
  capability fowner,
  capability fsetid,

  deny capability sys_admin,
  deny capability sys_module,
  deny capability sys_ptrace,
  deny capability sys_rawio,

  # ── Filesystem completo com escrita ───────────────────────────
  /                             r,
  /**                           rw,
  /**.so*                       mr,
  /lib/**                       mrix,
  /lib64/**                     mrix,
  /usr/lib/**                   mrix,
  /usr/local/lib/**             mrix,
  /bin/**                       mrix,
  /usr/bin/**                   mrix,
  /usr/local/bin/**             mrix,
  /usr/sbin/**                  mrix,
  /sbin/**                      mrix,

  # ── /proc e namespaces ────────────────────────────────────────
  /proc/                        r,
  /proc/**                      r,
  /proc/self/attr/**            rw,
  /proc/thread-self/attr/**     rw,
  /proc/[0-9]*/attr/**          rw,

  # ── /sys ──────────────────────────────────────────────────────
  /sys/                         r,
  /sys/**                       r,

  # ── Devices ───────────────────────────────────────────────────
  /dev/null                     rw,
  /dev/zero                     rw,
  /dev/full                     rw,
  /dev/random                   r,
  /dev/urandom                  r,
  /dev/pts/*                    rw,
  /dev/tty                      rw,

  # ── Rede ──────────────────────────────────────────────────────
  network inet  stream,
  network inet  dgram,
  network inet6 stream,
  network inet6 dgram,
  network unix  stream,
  network unix  dgram,

  deny network inet  raw,
  deny network inet6 raw,

  # ── Bloqueios de segurança mínimos ────────────────────────────
  deny /proc/sysrq-trigger      rw,
  deny /proc/kcore              rw,
  deny /proc/mem                rw,
  deny /proc/kmem               rw,

  deny mount,
  deny umount,
  deny pivot_root,
  deny ptrace,

  # ── Sinais ────────────────────────────────────────────────────
  signal (send,receive) peer=@{profile_name},

  # ── Unix sockets ──────────────────────────────────────────────
  unix (send,receive) type=stream,
  unix (send,receive) type=dgram,

  # ── /workspace permissões totais ──────────────────────────────
  /workspace/                   rwix,
  /workspace/**                 rwix,

  # ── /etc permissões para user management ──────────────────────
  /etc/passwd                   rw,
  /etc/passwd-                  rw,
  /etc/passwd.lock              rw,
  /etc/shadow                   rw,
  /etc/shadow-                  rw,
  /etc/shadow.lock              rw,
  /etc/group                    rw,
  /etc/group-                   rw,
  /etc/group.lock               rw,
  /etc/gshadow                  rw,
  /etc/gshadow-                 rw,
  /etc/gshadow.lock             rw,
}